datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  email       String   @unique
  name        String
  password    String
  role        String   // 'ADMIN' | 'STUDENT' — validated in application code
  score       String?  @default("N/A")
  profilePic  String?  // URL to uploaded profile picture; null = use default
  submissions         ExamSubmission[]
  attempts            ExamAttempt[]
  feedbacks           Feedback[]
  finalExamSubmissions FinalExamSubmission[]
  finalExamAttempts    FinalExamAttempt[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

type Option {
  id        String
  text      String
  imageUrl  String?
}

type Question {
  id                      String
  text                    String
  imageUrl                String?
  difficulty              String   // 'EASY' | 'MEDIUM' | 'HARD'
  points                  Int
  options                 Option[]
  correctOptionId         String?
  type                    String?  // 'MCQ' | 'SUBJECTIVE'
  correctSubjectiveAnswer String?  // model answer
  correctAnswerKeywords   String?  // comma-separated keywords
}

model Exam {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  description     String?
  durationMinutes Int
  totalPoints     Int        @default(100)
  type            String?    // 'MCQ' | 'SUBJECTIVE'
  startTime       DateTime?
  endTime         DateTime?
  subject         String?
  questions       Question[]
  submissions     ExamSubmission[]
  attempts        ExamAttempt[]
  feedbacks       Feedback[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

type Answer {
  questionId       String
  optionId         String?
  subjectiveAnswer String?
  pointsEarned     Int?
  feedback         String?
}

model ExamSubmission {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  examId      String   @db.ObjectId
  userName    String?  // denormalised for quick admin queries
  userEmail   String?  // denormalised for quick admin queries
  score       Int
  totalPoints Int
  answers     Answer[]
  graded      Boolean?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
}

model ExamAttempt {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  userId           String      @db.ObjectId
  examId           String      @db.ObjectId
  userName         String?     // denormalised for quick admin queries
  userEmail        String?     // denormalised for quick admin queries
  remainingChances Int         @default(3)
  status           String      @default("STARTED") // 'STARTED' | 'SUBMITTED' | 'TERMINATED'
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam             Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  violations       Violation[]
}

model Violation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  attemptId String   @db.ObjectId
  userId    String   @db.ObjectId
  userName  String?  // denormalised for quick admin queries
  userEmail String?  // denormalised for quick admin queries
  type      String   // FULLSCREEN_EXIT, TAB_SWITCH, COPY_ATTEMPT, PASTE_ATTEMPT, CUT_ATTEMPT, WINDOW_BLUR
  timestamp DateTime @default(now())
  metadata  String?

  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model Feedback {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  examId    String   @db.ObjectId
  userId    String   @db.ObjectId
  userName  String?  // denormalised for quick admin queries
  userEmail String?  // denormalised for quick admin queries
  rating    Int      // 1–5
  message   String?
  createdAt DateTime @default(now())

  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Final Examination Module ─────────────────────────────────────────────────

type FinalExamOption {
  id       String
  text     String
  imageUrl String?
}

type FinalExamQuestion {
  id                      String
  text                    String
  imageUrl                String?
  difficulty              String   // 'EASY' | 'MEDIUM' | 'HARD'
  points                  Int
  type                    String   // 'MCQ' | 'SUBJECTIVE'
  options                 FinalExamOption[]
  correctOptionId         String?
  correctSubjectiveAnswer String?
  correctAnswerKeywords   String?
}

type FinalExamSubject {
  id        String
  name      String
  questions FinalExamQuestion[]
}

type FinalExamAnswer {
  questionId       String
  subjectId        String
  optionId         String?
  subjectiveAnswer String?
  pointsEarned     Int?
  feedback         String?
}

model FinalExam {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  title              String
  description        String?
  instructions       String?
  syllabus           String?
  durationMinutes    Int
  startTime          DateTime
  endTime            DateTime
  gracePeriodSeconds Int       @default(10)
  passPercentage     Int       @default(40)
  subjects           FinalExamSubject[]
  submissions        FinalExamSubmission[]
  attempts           FinalExamAttempt[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model FinalExamSubmission {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  finalExamId     String   @db.ObjectId
  userId          String   @db.ObjectId
  userName        String?
  userEmail       String?
  score           Int
  totalPoints     Int
  percentage      Float?
  passed          Boolean?
  answers         FinalExamAnswer[]
  graded          Boolean? @default(false)
  isPublished     Boolean? @default(false)
  overallFeedback String?
  createdAt       DateTime @default(now())

  finalExam       FinalExam @relation(fields: [finalExamId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FinalExamAttempt {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  finalExamId      String      @db.ObjectId
  userId           String      @db.ObjectId
  userName         String?
  userEmail        String?
  remainingChances Int         @default(3)
  status           String      @default("STARTED") // 'STARTED' | 'SUBMITTED' | 'TERMINATED'
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  finalExam        FinalExam   @relation(fields: [finalExamId], references: [id], onDelete: Cascade)
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  violations       FinalExamViolation[]
}

model FinalExamViolation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  attemptId String   @db.ObjectId
  userId    String   @db.ObjectId
  userName  String?
  userEmail String?
  type      String
  timestamp DateTime @default(now())
  metadata  String?

  attempt   FinalExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model ProctoringSnapshot {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  finalExamId String   @db.ObjectId
  userId      String   @db.ObjectId
  userName    String?
  userEmail   String?
  imageData   String   // base64-encoded JPEG
  capturedAt  DateTime @default(now())
}
